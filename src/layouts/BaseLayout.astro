---
import { ViewTransitions } from 'astro:transitions';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { 
  title = "Spatialytics — Spatial Intelligence & Software for Greater Minnesota",
  description = "GIS, web applications, and business tools that keep high-value work and talent in Greater Minnesota."
} = Astro.props;

const navLinks = [
  { href: '/solutions', label: 'Solutions' },
  { href: '/work', label: 'Work' },
  { href: '/impact', label: 'Impact' },
  { href: '/compare', label: 'Compare Regions' },
  { href: '/about', label: 'About' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <ViewTransitions />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body class="min-h-screen bg-slate-950 text-slate-100 bg-topo">
    <header class="fixed top-0 inset-x-0 z-50 border-b border-slate-800/60 bg-slate-950/80 backdrop-blur-md" transition:persist>
      <div class="container-narrow flex items-center justify-between h-16">
        <a href="/" class="flex items-center gap-2 font-bold text-lg tracking-tight z-50">
          <span class="w-8 h-8 rounded-lg bg-gradient-to-br from-cyan-400 to-cyan-600 flex items-center justify-center text-slate-950 text-sm font-black">S</span>
          <span>Spatialytics</span>
        </a>

        <!-- Desktop nav -->
        <nav class="hidden md:flex items-center gap-8 text-sm font-medium text-slate-300">
          {navLinks.map(link => (
            <a href={link.href} class="hover:text-cyan-400 transition">{link.label}</a>
          ))}
          <a href="/contact" class="btn-primary text-sm !px-4 !py-2">Start a Project</a>
        </nav>

        <!-- Mobile menu button -->
        <button 
          id="mobile-menu-btn"
          class="md:hidden z-50 p-2 text-slate-300 hover:text-white transition"
          aria-label="Toggle menu"
          aria-expanded="false"
        >
          <svg id="menu-icon-open" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg id="menu-icon-close" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <!-- Mobile menu panel -->
      <div 
        id="mobile-menu" 
        class="md:hidden fixed inset-0 top-16 bg-slate-950/95 backdrop-blur-lg border-t border-slate-800 translate-x-full transition-transform duration-300 ease-out"
      >
        <nav class="container-narrow py-8 flex flex-col gap-1">
          {navLinks.map(link => (
            <a 
              href={link.href} 
              class="mobile-nav-link px-4 py-3 text-lg font-medium text-slate-200 hover:text-cyan-400 hover:bg-slate-900/50 rounded-xl transition"
            >
              {link.label}
            </a>
          ))}
          <a 
            href="/contact" 
            class="mt-4 btn-primary text-center"
          >
            Start a Project
          </a>
        </nav>
      </div>
    </header>

    <main class="pt-16">
      <slot />
    </main>

    <footer class="border-t border-slate-800 mt-20">
      <div class="container-narrow py-12 flex flex-col md:flex-row justify-between gap-8">
        <div>
          <div class="font-bold text-lg mb-2 flex items-center gap-2">
            <span class="w-7 h-7 rounded-md bg-gradient-to-br from-cyan-400 to-cyan-600 flex items-center justify-center text-slate-950 text-xs font-black">S</span>
            Spatialytics
          </div>
          <p class="text-slate-400 text-sm max-w-xs">
            Spatial intelligence and software solutions that reduce overhead, improve wages, and keep value in Greater Minnesota.
          </p>
        </div>
        <div class="flex gap-12 text-sm text-slate-400">
          <div class="space-y-2">
            <div class="font-medium text-slate-200">Solutions</div>
            <a href="/solutions/spatial" class="block hover:text-cyan-400 transition">Spatial Intelligence</a>
            <a href="/solutions/print-pod" class="block hover:text-cyan-400 transition">Print & POD</a>
            <a href="/solutions/business" class="block hover:text-cyan-400 transition">Business Apps</a>
          </div>
          <div class="space-y-2">
            <div class="font-medium text-slate-200">Company</div>
            <a href="/work" class="block hover:text-cyan-400 transition">Work</a>
            <a href="/impact" class="block hover:text-cyan-400 transition">Impact</a>
            <a href="/compare" class="block hover:text-cyan-400 transition">Regional Comparison</a>
            <a href="/about" class="block hover:text-cyan-400 transition">About</a>
            <a href="/contact" class="block hover:text-cyan-400 transition">Contact</a>
          </div>
        </div>
      </div>
      <div class="border-t border-slate-800/60">
        <div class="container-narrow py-6 text-xs text-slate-500 flex flex-col sm:flex-row justify-between gap-2">
          <span>© {new Date().getFullYear()} Spatialytics LLC · Brainerd Lakes Area, Minnesota</span>
          <span>Built with Astro</span>
        </div>
      </div>
    </footer>

    <script>
      function initMobileMenu() {
        const btn = document.getElementById('mobile-menu-btn');
        const menu = document.getElementById('mobile-menu');
        const iconOpen = document.getElementById('menu-icon-open');
        const iconClose = document.getElementById('menu-icon-close');
        if (!btn || !menu || !iconOpen || !iconClose) return;

        const closeMenu = () => {
          menu.classList.add('translate-x-full');
          iconOpen.classList.remove('hidden');
          iconClose.classList.add('hidden');
          btn.setAttribute('aria-expanded', 'false');
          document.body.style.overflow = '';
        };

        const openMenu = () => {
          menu.classList.remove('translate-x-full');
          iconOpen.classList.add('hidden');
          iconClose.classList.remove('hidden');
          btn.setAttribute('aria-expanded', 'true');
          document.body.style.overflow = 'hidden';
        };

        btn.addEventListener('click', () => {
          const isOpen = btn.getAttribute('aria-expanded') === 'true';
          if (isOpen) closeMenu();
          else openMenu();
        });

        menu.querySelectorAll('.mobile-nav-link, a.btn-primary').forEach(link => {
          link.addEventListener('click', closeMenu);
        });
      }

      initMobileMenu();
      document.addEventListener('astro:page-load', initMobileMenu);
    </script>
  </body>
</html>
