---
import { ViewTransitions } from 'astro:transitions';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { 
  title = "Spatialytics — Spatial Intelligence & Software for Greater Minnesota",
  description = "GIS, web applications, and business tools that keep high-value work and talent in Greater Minnesota."
} = Astro.props;

const navLinks = [
  { href: '/solutions', label: 'Solutions' },
  { href: '/work', label: 'Work' },
  { href: '/impact', label: 'Impact' },
  { href: '/compare', label: 'Compare Regions' },
  { href: '/about', label: 'About' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <ViewTransitions />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body class="min-h-screen bg-slate-950 text-slate-100 bg-topo">
    <!-- Checkbox first so peer-* works on following siblings -->
    <input type="checkbox" id="nav-toggle" class="peer sr-only" />

    <header class="fixed top-0 inset-x-0 z-[100] border-b border-slate-700/80 bg-slate-950 shadow-lg shadow-black/30" transition:persist="header">
      <div class="container-narrow flex items-center justify-between h-16">
        <a href="/" class="flex items-center gap-2 font-bold text-lg tracking-tight relative z-[110]">
          <span class="w-8 h-8 rounded-lg bg-gradient-to-br from-cyan-400 to-cyan-600 flex items-center justify-center text-slate-950 text-sm font-black">S</span>
          <span class="text-white">Spatialytics</span>
        </a>

        <!-- Desktop nav -->
        <nav class="hidden md:flex items-center gap-8 text-sm font-medium text-slate-300">
          {navLinks.map(link => (
            <a href={link.href} class="hover:text-cyan-400 transition">{link.label}</a>
          ))}
          <a href="/contact" class="btn-primary text-sm !px-4 !py-2">Start a Project</a>
        </nav>

        <!-- Mobile hamburger -->
        <label 
          for="nav-toggle" 
          class="md:hidden relative z-[110] flex items-center justify-center w-11 h-11 rounded-xl bg-slate-800 border border-slate-500 text-white hover:bg-slate-700 hover:border-cyan-400/60 cursor-pointer select-none shadow-md"
          aria-label="Toggle menu"
        >
          <svg class="w-6 h-6 open-icon" fill="none" stroke="currentColor" stroke-width="2.25" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg class="w-6 h-6 close-icon hidden" fill="none" stroke="currentColor" stroke-width="2.25" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </label>
      </div>
    </header>

    <!-- Full-screen solid menu — OUTSIDE header so fixed is relative to viewport -->
    <div 
      class="mobile-panel md:hidden fixed inset-0 z-[95] bg-slate-950
             opacity-0 pointer-events-none transition-opacity duration-200
             peer-checked:opacity-100 peer-checked:pointer-events-auto"
    >
      <div class="h-16 border-b border-slate-700"></div>
      <nav class="container-narrow py-8 flex flex-col gap-1">
        {navLinks.map(link => (
          <a 
            href={link.href} 
            class="mobile-link px-4 py-3 text-lg font-medium text-white hover:text-cyan-400 hover:bg-slate-900 rounded-xl transition"
          >
            {link.label}
          </a>
        ))}
        <a 
          href="/contact" 
          class="mobile-link mt-4 btn-primary text-center"
        >
          Start a Project
        </a>
      </nav>
    </div>

    <main class="pt-16">
      <slot />
    </main>

    <footer class="border-t border-slate-800 mt-20">
      <div class="container-narrow py-12 flex flex-col md:flex-row justify-between gap-8">
        <div>
          <div class="font-bold text-lg mb-2 flex items-center gap-2">
            <span class="w-7 h-7 rounded-md bg-gradient-to-br from-cyan-400 to-cyan-600 flex items-center justify-center text-slate-950 text-xs font-black">S</span>
            Spatialytics
          </div>
          <p class="text-slate-400 text-sm max-w-xs">
            Spatial intelligence and software solutions that reduce overhead, improve wages, and keep value in Greater Minnesota.
          </p>
        </div>
        <div class="flex gap-12 text-sm text-slate-400">
          <div class="space-y-2">
            <div class="font-medium text-slate-200">Solutions</div>
            <a href="/solutions/spatial" class="block hover:text-cyan-400 transition">Spatial Intelligence</a>
            <a href="/solutions/print-pod" class="block hover:text-cyan-400 transition">Print & POD</a>
            <a href="/solutions/business" class="block hover:text-cyan-400 transition">Business Apps</a>
          </div>
          <div class="space-y-2">
            <div class="font-medium text-slate-200">Company</div>
            <a href="/work" class="block hover:text-cyan-400 transition">Work</a>
            <a href="/impact" class="block hover:text-cyan-400 transition">Impact</a>
            <a href="/compare" class="block hover:text-cyan-400 transition">Regional Comparison</a>
            <a href="/about" class="block hover:text-cyan-400 transition">About</a>
            <a href="/contact" class="block hover:text-cyan-400 transition">Contact</a>
          </div>
        </div>
      </div>
      <div class="border-t border-slate-800/60">
        <div class="container-narrow py-6 text-xs text-slate-500 flex flex-col sm:flex-row justify-between gap-2">
          <span>© {new Date().getFullYear()} Spatialytics LLC · Brainerd Lakes Area, Minnesota</span>
          <span>Built with Astro</span>
        </div>
      </div>
    </footer>

    <style>
      /* Icon swap */
      #nav-toggle:checked ~ header label .open-icon { display: none !important; }
      #nav-toggle:checked ~ header label .close-icon { display: block !important; }

      /* Solid full-screen panel — never transparent */
      .mobile-panel {
        background-color: #020617 !important;
      }

      header label[for="nav-toggle"] {
        color: #fff !important;
      }
    </style>

    <script is:inline>
      document.addEventListener('click', function (e) {
        const link = e.target.closest && e.target.closest('.mobile-link');
        if (link) {
          const toggle = document.getElementById('nav-toggle');
          if (toggle) toggle.checked = false;
        }
      });
    </script>
  </body>
</html>
