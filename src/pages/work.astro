---
import BaseLayout from '../layouts/BaseLayout.astro';

const featured = [
  {
    title: "AskBen",
    description: "B2C money triage. You type the bills. Ben ranks what to pay next. No bank login. Franklin’s Landing unlocks after the ledger has one number. Full town + ledger-first path shipped 28 Aug 2026.",
    tags: ["B2C", "Next.js", "Supabase", "Three.js"],
    live: "https://www.askben.buzz",
    repo: "https://github.com/KristineMK72/money-control-saas",
    category: "Consumer Product",
    accent: "amber"
  },
  {
    title: "Aperture",
    description: "Community intelligence for schools and public agencies. Mental health, bullying, and suicide indicators joined to U.S. Census ACS so a place can see risk next to neighborhood context. Private preview.",
    tags: ["Civic", "Census ACS", "Community Health"],
    live: null,
    repo: null,
    category: "Civic Intelligence",
    accent: "cyan"
  },
  {
    title: "MN Groundwater Screen",
    description: "Pin-drop Minnesota groundwater screen: live CWI wells, water-table vulnerability, and a site score for Greater Minnesota.",
    tags: ["MapLibre", "CWI", "Natural Resources"],
    live: "https://spatialytics-groundwater.vercel.app",
    repo: "https://github.com/KristineMK72/spatialytics-groundwater",
    category: "Spatial Intelligence",
    accent: "cyan"
  },
  {
    title: "Grant Match",
    description: "Map-first grant discovery and a guided proposal writer for Greater Minnesota nonprofits. Search local + Grants.gov, then start a draft from any listing.",
    tags: ["Next.js", "MapLibre", "Grants.gov", "Social Impact"],
    live: "https://spatialytics-grant-match.vercel.app",
    repo: "https://github.com/KristineMK72/spatialytics-grant-match",
    category: "Social Impact",
    accent: "cyan"
  },
  {
    title: "HyperLocal Insights",
    description: "Drop a pin or search an address to read the neighborhood — competitors, demographics, and zoning in one map-first panel.",
    tags: ["Leaflet", "OSM", "Census ACS"],
    live: "https://hyperlocal-insights.vercel.app",
    repo: "https://github.com/KristineMK72/hyperlocal-insights",
    category: "Spatial Intelligence",
    accent: "cyan"
  },
  {
    title: "GH-Impact Wrangler",
    description: "Zero-friction geo cleaning: drop CSV, GeoJSON, or a zipped shapefile and get web-ready data without a desktop GIS stack.",
    tags: ["GeoJSON", "FastAPI", "Data Prep"],
    live: "https://gh-impact-wrangler.vercel.app",
    repo: "https://github.com/KristineMK72/gh-impact-wrangler",
    category: "Spatial Tools",
    accent: "cyan"
  }
];

const projects = [
  {
    title: "Closing Task List",
    description: "Retail close-out checklist for a shift that has to actually finish — built for the Cosmoprof floor, reusable anywhere the night has a list.",
    tags: ["Ops", "HTML", "Retail"],
    live: null,
    repo: "https://github.com/KristineMK72/ClosingTaskList",
    category: "Ops"
  },
  {
    title: "3D Bear Habitat Explorer",
    description: "Interactive WebGL terrain with habitat overlays for non-GIS audiences.",
    tags: ["MapLibre", "3D", "WebGL"],
    live: "https://bear-habitat-astro.vercel.app/",
    repo: "https://github.com/KristineMK72/bear-habitat-3d",
    category: "Spatial"
  },
  {
    title: "Brainerd Tech Growth Dashboard",
    description: "Regional dashboard exploring tech employment, wages, and opportunity in the Brainerd Lakes area.",
    tags: ["Dashboard", "Data Viz", "Regional"],
    live: "https://brainerd-tech-growth-dashboard.vercel.app",
    repo: "https://github.com/KristineMK72/brainerd-tech-growth-dashboard",
    category: "Spatial"
  },
  {
    title: "Kelly & Sons Towing",
    description: "Modern web presence for a local towing business — clean, mobile-first, conversion-focused.",
    tags: ["Client Work", "TypeScript"],
    live: "https://kelly-and-sons-towing.vercel.app",
    repo: "https://github.com/KristineMK72/kelly-and-sons-towing",
    category: "Client"
  },
  {
    title: "Debbie's Wave Salon",
    description: "Website for a local salon — focused on clarity, booking readiness, and local feel.",
    tags: ["Client Work", "TypeScript"],
    live: "https://debbies-wave-salon.vercel.app",
    repo: "https://github.com/KristineMK72/debbies-wave-salon",
    category: "Client"
  },
  {
    title: "Grit & Grace / Resilient Voice",
    description: "Astro headless frontend redesign that consumes existing APIs without breaking the live Next.js store.",
    tags: ["Astro", "Headless", "E-commerce"],
    live: "https://grit-and-grace-astro.vercel.app",
    repo: "https://github.com/KristineMK72/grit-and-grace-astro",
    category: "Platform"
  },
  {
    title: "Warren Kahler 80",
    description: "Celebration site for an 80th birthday — storytelling, photos, and community.",
    tags: ["Personal", "TypeScript"],
    live: "https://warren-kahler-80.vercel.app",
    repo: "https://github.com/KristineMK72/warren-kahler-80",
    category: "Storytelling"
  }
];
---

<BaseLayout 
  title="Our Work — Spatialytics"
  description="AskBen, Aperture, groundwater, grant match, and the newest Spatialytics apps."
>
  <section class="section">
    <div class="container-narrow">
      <div class="max-w-3xl mb-16">
        <p class="text-cyan-400 font-medium mb-3 text-sm uppercase tracking-wide">Portfolio</p>
        <h1 class="text-4xl md:text-5xl font-bold mb-6 leading-tight">
          Explore the work
        </h1>
        <p class="text-lg text-slate-300 leading-relaxed">
          This week’s stack: AskBen for households, Aperture for schools and agencies, pin-drop groundwater and hyperlocal intel for places.
        </p>
      </div>

      <div class="mb-20">
        <h2 class="text-sm font-semibold text-slate-400 uppercase tracking-wider mb-8">Featured</h2>
        <div class="grid md:grid-cols-3 gap-6">
          {featured.map((project) => (
            <article class="card group flex flex-col h-full">
              <div class="flex items-center gap-2 mb-4">
                <span class={`text-xs font-medium px-2.5 py-1 rounded-full ${project.accent === 'amber' ? 'bg-amber-500/10 text-amber-400' : 'bg-cyan-500/10 text-cyan-400'}`}>
                  {project.category}
                </span>
              </div>
              <h3 class="text-xl font-semibold mb-3 group-hover:text-cyan-400 transition">
                {project.title}
              </h3>
              <p class="text-slate-400 text-sm leading-relaxed mb-5 flex-1">
                {project.description}
              </p>
              <div class="flex flex-wrap gap-2 mb-6">
                {project.tags.map((tag) => (
                  <span class="text-xs text-slate-500 border border-slate-700 px-2 py-0.5 rounded">
                    {tag}
                  </span>
                ))}
              </div>
              <div class="flex flex-wrap gap-3 mt-auto">
                {project.live && (
                  <a href={project.live} target="_blank" rel="noopener" class="btn-primary text-sm !px-4 !py-2">Live Demo →</a>
                )}
                {project.repo && (
                  <a href={project.repo} target="_blank" rel="noopener" class="btn-secondary text-sm !px-4 !py-2">Code</a>
                )}
                {!project.live && !project.repo && (
                  <span class="text-xs text-slate-500">Private preview</span>
                )}
              </div>
            </article>
          ))}
        </div>
      </div>

      <div>
        <h2 class="text-sm font-semibold text-slate-400 uppercase tracking-wider mb-8">More projects</h2>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
          {projects.map((project) => {
            const href = project.live || project.repo;
            const isLive = Boolean(project.live);
            return (
              <a href={href} target="_blank" rel="noopener" class="card group block">
                <div class="flex items-start justify-between gap-3 mb-3">
                  <h3 class="font-semibold group-hover:text-cyan-400 transition leading-snug">{project.title}</h3>
                  <span class="text-xs shrink-0 mt-0.5">
                    {isLive ? <span class="text-cyan-400 font-medium">Live →</span> : <span class="text-slate-500">Code ↗</span>}
                  </span>
                </div>
                <p class="text-slate-400 text-sm leading-relaxed mb-4">{project.description}</p>
                <div class="flex flex-wrap gap-1.5 items-center">
                  {project.tags.map((tag) => (
                    <span class="text-xs text-slate-500">{tag}</span>
                  ))}
                </div>
              </a>
            );
          })}
        </div>
      </div>

      <div class="mt-20 text-center card border-cyan-500/30">
        <h2 class="text-2xl font-bold mb-4">Have a project in mind?</h2>
        <p class="text-slate-300 max-w-xl mx-auto mb-8">
          Spatial platform, civic layer, or a custom efficiency tool — let’s build something that stays local.
        </p>
        <a href="/contact" class="btn-primary">Start a Conversation</a>
      </div>
    </div>
  </section>
</BaseLayout>
