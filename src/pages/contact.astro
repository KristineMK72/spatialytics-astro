---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout 
  title="Contact — Spatialytics"
  description="Start a conversation about spatial platforms, POD systems, or business efficiency tools for Greater Minnesota."
>
  <section class="section">
    <div class="container-narrow">
      <div class="max-w-3xl mb-16">
        <p class="text-cyan-400 font-medium mb-3 text-sm uppercase tracking-wide">Contact</p>
        <h1 class="text-4xl md:text-5xl font-bold mb-6 leading-tight">
          Let’s build something that stays local
        </h1>
        <p class="text-lg text-slate-300 leading-relaxed">
          Whether you need a spatial platform, a POD system for a print shop, a custom efficiency app, or just want to explore what’s possible — reach out. Based in the Brainerd Lakes area and working across Greater Minnesota.
        </p>
      </div>

      <div class="grid lg:grid-cols-5 gap-12">
        <div class="lg:col-span-3">
          <!--
            Form works with Formspree (free tier).
            Create an account at formspree.io and replace the action URL with your form endpoint.
            Example: action="https://formspree.io/f/your-id"
          -->
          <form 
            action="https://formspree.io/f/xpwzgkqr"
            method="POST"
            class="card space-y-6"
          >
            <div class="grid sm:grid-cols-2 gap-6">
              <div>
                <label for="name" class="block text-sm font-medium text-slate-300 mb-2">Name</label>
                <input 
                  type="text" 
                  id="name" 
                  name="name" 
                  required
                  class="w-full px-4 py-3 rounded-xl bg-slate-950 border border-slate-700 text-slate-100 placeholder-slate-500 focus:outline-none focus:border-cyan-500 focus:ring-1 focus:ring-cyan-500/50 transition"
                  placeholder="Your name"
                />
              </div>
              <div>
                <label for="email" class="block text-sm font-medium text-slate-300 mb-2">Email</label>
                <input 
                  type="email" 
                  id="email" 
                  name="email" 
                  required
                  class="w-full px-4 py-3 rounded-xl bg-slate-950 border border-slate-700 text-slate-100 placeholder-slate-500 focus:outline-none focus:border-cyan-500 focus:ring-1 focus:ring-cyan-500/50 transition"
                  placeholder="you@example.com"
                />
              </div>
            </div>

            <div>
              <label for="organization" class="block text-sm font-medium text-slate-300 mb-2">Organization (optional)</label>
              <input 
                type="text" 
                id="organization" 
                name="organization"
                class="w-full px-4 py-3 rounded-xl bg-slate-950 border border-slate-700 text-slate-100 placeholder-slate-500 focus:outline-none focus:border-cyan-500 focus:ring-1 focus:ring-cyan-500/50 transition"
                placeholder="Company, city, nonprofit..."
              />
            </div>

            <div>
              <label for="interest" class="block text-sm font-medium text-slate-300 mb-2">I’m interested in</label>
              <select 
                id="interest" 
                name="interest"
                class="w-full px-4 py-3 rounded-xl bg-slate-950 border border-slate-700 text-slate-100 focus:outline-none focus:border-cyan-500 focus:ring-1 focus:ring-cyan-500/50 transition"
              >
                <option value="spatial">Spatial Intelligence / Web GIS</option>
                <option value="pod">Print & POD Platform</option>
                <option value="business">Business Efficiency App</option>
                <option value="general">General inquiry / partnership</option>
                <option value="other">Something else</option>
              </select>
            </div>

            <div>
              <label for="message" class="block text-sm font-medium text-slate-300 mb-2">Message</label>
              <textarea 
                id="message" 
                name="message" 
                rows="5" 
                required
                class="w-full px-4 py-3 rounded-xl bg-slate-950 border border-slate-700 text-slate-100 placeholder-slate-500 focus:outline-none focus:border-cyan-500 focus:ring-1 focus:ring-cyan-500/50 transition resize-y"
                placeholder="Tell me a bit about what you’re working on or looking for..."
              ></textarea>
            </div>

            <button type="submit" class="btn-primary w-full sm:w-auto">
              Send Message
            </button>
          </form>
          <p class="text-xs text-slate-500 mt-4">
            Prefer email? Write directly to <a href="mailto:hello@spatialytics.space" class="text-cyan-400 hover:underline">hello@spatialytics.space</a>
          </p>
        </div>

        <div class="lg:col-span-2 space-y-6">
          <div class="card">
            <h3 class="font-semibold mb-4">Based in</h3>
            <p class="text-slate-300 text-sm leading-relaxed">
              Brainerd Lakes Area<br />
              Crow Wing County, Minnesota
            </p>
          </div>

          <div class="card">
            <h3 class="font-semibold mb-4">What to expect</h3>
            <ul class="space-y-3 text-sm text-slate-300">
              <li class="flex gap-2"><span class="text-cyan-400">→</span> A real reply (usually within a couple of business days)</li>
              <li class="flex gap-2"><span class="text-cyan-400">→</span> Clear next steps if there’s a fit</li>
              <li class="flex gap-2"><span class="text-cyan-400">→</span> No pressure sales process</li>
            </ul>
          </div>

          <div class="card border-cyan-500/20">
            <h3 class="font-semibold mb-3">Looking for something specific?</h3>
            <ul class="space-y-2 text-sm">
              <li><a href="/solutions/spatial" class="text-cyan-400 hover:underline">Spatial Intelligence</a></li>
              <li><a href="/solutions/print-pod" class="text-cyan-400 hover:underline">Print & POD Platform</a></li>
              <li><a href="/solutions/business" class="text-cyan-400 hover:underline">Business Efficiency Apps</a></li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
